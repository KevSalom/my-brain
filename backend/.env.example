# =============================================
# My Brain LM - Variables de Entorno
# Copia este archivo como .env y completa los valores
# =============================================

# Clave de API de OpenAI (obligatoria)
OPENAI_API_KEY=your-api-key-here

# Modelo de embeddings a utilizar
EMBEDDING_MODEL=text-embedding-3-small

# Modelo de lenguaje para el chat
LLM_MODEL=gpt-4o-mini

# Directorio de persistencia de ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Tamaño de cada chunk de texto (en caracteres)
CHUNK_SIZE=1000

# Solapamiento entre chunks consecutivos (en caracteres)
CHUNK_OVERLAP=200

# Estrategia de chunking a utilizar:
#   basic — Separadores genéricos (párrafos, líneas, oraciones)
#   smart — Separadores conscientes de código + metadata enriquecida (recomendado para docs técnicos)
CHUNKING_STRATEGY=smart

# --- Estrategia de Retrieval ---
# Estrategia de recuperación de documentos:
#   vector_only — Solo búsqueda semántica por embeddings
#   hybrid     — BM25 (keywords) + Vectorial (semántica) con Reciprocal Rank Fusion
RETRIEVAL_STRATEGY=hybrid

# Peso de BM25 en la estrategia híbrida (0.0 a 1.0)
# Para documentación técnica, 0.4 es un buen punto de partida
# El peso vectorial es automáticamente (1.0 - este valor)
RETRIEVAL_BM25_WEIGHT=0.4

# Directorio donde se colocan los documentos a ingestar
DOCUMENTS_DIR=./documents

# --- API REST (Fase 1) ---
# Host y puerto para el servidor FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# --- CORS (Fase 2) ---
# Dominios adicionales permitidos para CORS (separados por comas)
# ALLOWED_ORIGINS=http://midominio.com,https://otrodominio.com

